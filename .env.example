# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these, TypeQuest runs in guest mode (no accounts, saving or leaderboards).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — never expose this. Used to save validated runs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_AUTH_GOOGLE=false
